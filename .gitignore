# Secrets — never commit real keys; .env.example documents every variable
.env
.env.*
!.env.example

# Runtime data: agent run scratch dirs, logs, backups, download caches
data/

# Python
__pycache__/
*.py[cod]
.venv/
.pytest_cache/
.ruff_cache/
.mypy_cache/
*.egg-info/

# Node / frontend
node_modules/
frontend/dist/
*.tsbuildinfo
coverage/
playwright-report/
test-results/

# Claude Code local-only settings
.claude/settings.local.json

# Editors / OS
.vscode/*
!.vscode/extensions.json
.idea/
.DS_Store
Thumbs.db
*.log
