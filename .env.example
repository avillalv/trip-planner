# Trip Planner configuration. `npm run setup` copies this file to .env and fills in the
# generated secrets. .env is gitignored — never commit real keys.

# --- Database -------------------------------------------------------------------
# The app's own login. Setup creates this role and both databases for you.
DATABASE_URL=postgresql+psycopg://tripplanner:CHANGE_ME_DB_PASSWORD@localhost:5432/tripplanner
TEST_DATABASE_URL=postgresql+psycopg://tripplanner:CHANGE_ME_DB_PASSWORD@localhost:5432/tripplanner_test
# Superuser that setup uses once to create the role. Its password is prompted, never stored.
POSTGRES_SUPERUSER=postgres

# --- Web server -----------------------------------------------------------------
# 127.0.0.1 = this PC only. HOST=0.0.0.0 opens the app to devices on your Wi-Fi
# (needs APP_PASSCODE and the firewall rule described in the README).
HOST=127.0.0.1
PORT=8000

# --- Secrets (generated by setup when blank) ------------------------------------
SESSION_SECRET=
# Agent routines send this key to the local ingest API, which only accepts calls from this PC.
AGENT_INGEST_API_KEY=
# Passcode that other devices on your Wi-Fi enter once to use the app.
APP_PASSCODE=

# --- Data providers (free tiers) ------------------------------------------------
# Places search + destination autocomplete — https://myprojects.geoapify.com
GEOAPIFY_API_KEY=
# Live Google Flights prices + vacation rentals — https://serpapi.com/manage-api-key
SERPAPI_API_KEY=
# Cached Aviasales fares — https://www.travelpayouts.com (Profile > API token)
TRAVELPAYOUTS_TOKEN=

# --- Preferences ----------------------------------------------------------------
HOME_CURRENCY=USD
# Full path to the Claude Code CLI, only if `claude` isn't on PATH.
CLAUDE_PATH=
LOG_LEVEL=INFO
